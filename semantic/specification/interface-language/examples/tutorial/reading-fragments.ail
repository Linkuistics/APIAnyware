// region: lending-input
fn current_label(card: Card) -> Label {
  input($card, borrow);
  retain($card, none);
  valid($card, call);
}
// endregion

// region: lending-result
fn current_label(card: Card) -> Label {
  outcome lent {
    when(returned, any);
    meaning(success);
    state($result, valid);
    give($result, borrow(owner($card)));
    invalidated_by($result, [@refresh_card]);
  }
}
// endregion

// region: lending-refresh
fn refresh_card(card: Card) -> unit {
  mutation(arguments);
  input($card, borrow);
  retain($card, none);
  valid($card, call);
}
// endregion

