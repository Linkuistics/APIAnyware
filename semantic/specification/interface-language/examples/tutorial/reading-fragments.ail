// region: lifetime-outcomes
fn create_card() -> nullable<Card> {
  outcome created {
    when(returned, nonnull($result));
    meaning(success);
    state($result, valid);
    give($result, owned);
  }
  outcome allocation_failed {
    when(returned, null($result));
    meaning(failure);
    state($result, valid);
    give($result, owned);
  }
}
// endregion

// region: lifetime-consume
fn destroy_card(card: Card) -> unit {
  input($card, consume);
  retain($card, none);
  outcome done {
    when(returned, any);
    meaning(success);
  }
}
// endregion

// region: lifetime-effects-access
fn create_card() -> nullable<Card> {
  available([test]);
  deprecated(no);
  execution(sync);
  completions([returned]);
  executor(any);
  concurrency(parallel);
  reentrancy(allowed);
  mutation(none);
  variadic(false);
  // Outcomes omitted.
  access direct in [test] {
    abi(native, "c");
    via(fixture, "symbol", "fixture_create_card");
    mapping(identity);
    compatibility(stable);
  }
}
// endregion

