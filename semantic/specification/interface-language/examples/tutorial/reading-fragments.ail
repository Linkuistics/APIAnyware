// region: lifetime-resource
package tutorial::lifetime version "1" {
  resource Card {
    available([test]);
    deprecated(no);
    implements([]);
    lifecycle(unique, @destroy_card);
    sharing(transferable);
    isolation(none);
  }
  // create_card and destroy_card are sibling declarations, omitted here.
}
