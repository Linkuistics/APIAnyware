    lifecycle(refcounted, runtime(fixture, "retain"), runtime(fixture, "release"));
    sharing(confined);
    isolation(main);
    // Base, interfaces, availability and deprecation omitted.
  }
  // Header, fixture pin, members and publication context omitted.
}
