  environment test {
    target("fixture64");
    platform("fixture", "1");
  }
  record Point {
    available([test]);
    deprecated(no);
    field x: i32;
    field y: i32;
    // Remaining nominal contracts omitted.
  }
  // Header, provider pins and publication context omitted.
}
// endregion

// region: relations
package example::drawing version "1" {
  interface Drawable {
    extends([]);
    // Nominal contracts omitted.
  }
  object Shape {
    base(none);
    implements([]);
    // Nominal contracts omitted.
  }
  object Dot {
    base(@Shape);
    implements([@Drawable]);
    // Nominal contracts omitted.
  }
  // Header, providers, members and publication context omitted.
}
// endregion

// region: deprecated
