// Independent teaching fragments, not concatenable complete packages.
// Adapted from examples/objects.ail and rule-reading/{syntax,clauses,contracts}.ail.
// The environment region illustrates L3 with hypothetical provider values;
// it does not extend F1. Fixture references elsewhere are synthetic.

// region: property
package example::objects version "1" {
  property count: u64 {
    member(@Counter, instance);
    accessors(@read_count, @write_count);
    storage(value);
    // Availability and deprecation omitted.
  }
  // Counter and the full read_count/write_count functions omitted.
  // Getter: (receiver: Counter) -> u64.
  // Setter: (receiver: Counter, value: u64) -> unit.
}
// endregion

// region: availability
