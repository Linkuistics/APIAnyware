// Independent explanatory fragments, not complete or concatenable packages.

// region: borrow
fn view(store: Store) -> ptr<u8> {
  input($store, borrow);
  valid($store, call);
  outcome viewed {
    when(returned, any);
    meaning(success);
    state($result, valid);
    give($result, borrow(owner($store)));
    invalidated_by($result, []);
  }
  // Retention, remaining effects, extent, contents and access omitted.
}
// endregion

// region: callback
fn subscribe(handler: Handler) -> Subscription {
  input($handler, borrow);
  retain($handler, strong(owner($result)));
  valid($handler, call);
  callback $handler {
    timing(after_return);
    count(0, many);
    scope(owner($result));
    executor(any);
    concurrency(serial);
    reentrancy(forbidden);
    quiescence(@unsubscribe);
  }
  // Effects, outcome and access omitted.
}
// endregion

