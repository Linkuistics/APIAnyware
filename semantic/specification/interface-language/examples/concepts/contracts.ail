// region: subscription-schedule
fn subscribe(handler: Handler) -> Subscription {
  callback $handler {
    timing(after_return);
    count(0, many);
    scope(owner($result));
    executor(any);
    concurrency(serial);
    reentrancy(forbidden);
    quiescence(@unsubscribe);
  }
  // Other callable contracts omitted.
}
// endregion

// region: call-schedule
fn notify(handler: Handler) -> unit {
  execution(sync);
  input($handler, borrow);
  retain($handler, none);
  valid($handler, call);
  callback $handler {
    timing(during_call);
    count(1, 1);
    scope(call);
    executor(any);
    concurrency(serial);
    reentrancy(forbidden);
    quiescence(return);
  }
  // Other callable contracts omitted.
}
// endregion

